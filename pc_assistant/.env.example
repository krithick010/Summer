# ============================================================
# .env.example  —  copy to .env and fill in your real values
# ============================================================

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Comma-separated Telegram user IDs allowed to interact with the bot
ALLOWED_USER_IDS=123456789

# --- Server ---
# Network interface to bind the FastAPI server
SERVER_HOST=0.0.0.0
# Port to listen on
SERVER_PORT=8000
# Public webhook base URL (leave empty for development long-polling)
WEBHOOK_URL=

# --- Identity ---
# How the assistant addresses you in conversation
USER_NAME=friend
# The persona name of the assistant
ASSISTANT_NAME=Summer
# Optional home location for weather, news, and local queries (e.g. "City, Region, Country")
USER_LOCATION=

# --- Web Plugins (Playwright) ---
# Requires one-time Chromium install: playwright install chromium
# Failed page loads save diagnostic PNGs under data/debug/ (newest 10 kept).
# Run Chromium headlessly (true), or set to false so you can watch the browser window
BROWSER_HEADLESS=true
# Comma-separated AI news URLs tried in order until one yields >= 3 clean headlines.
# Web pages change over time — swap or reorder sources here in .env anytime.
AI_NEWS_URLS=https://techcrunch.com/category/artificial-intelligence/,https://venturebeat.com/category/ai/

# --- Ollama / LLM ---
# Ollama service endpoint URL
OLLAMA_BASE_URL=http://localhost:11434
# Primary chat model to run on Ollama
OLLAMA_MODEL=qwen2.5:3b
# Context window size in tokens
OLLAMA_NUM_CTX=4096
# How long Ollama keeps the chat/extractor model loaded in memory
OLLAMA_KEEP_ALIVE=30m
# Maximum tokens to generate per response
LLM_MAX_TOKENS=512
# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.6
# Optional "think" toggle for qwen3-family models (true, false, or leave empty to omit)
LLM_THINK=
# Model used for background structured memory extraction
EXTRACTOR_MODEL=qwen2.5:3b
# Whether background memory extraction is active
EXTRACTOR_ENABLED=true

# --- Data & Storage ---
# Base directory for persistent application data
DATA_DIR=data
# Path to SQLite conversation history database (or :memory: for ephemeral)
HISTORY_DB_PATH=data/history.db
# Path to ChromaDB persistent vector database folder
MEMORY_DB_PATH=data/memory_db

# --- Memory & History ---
# Number of conversation turns retained in rolling history
HISTORY_TURNS=8
# Embedding model for vector memories
EMBEDDING_MODEL=nomic-embed-text
# Run embeddings on CPU (num_gpu=0) so chat LLM keeps GPU VRAM
EMBED_ON_CPU=true
# Number of relevant memories retrieved per turn
MEMORY_TOP_K=5
# Maximum semantic distance threshold for memory retrieval
MEMORY_MAX_DISTANCE=1.3
# Backward compatibility alias for distance threshold
MEMORY_DISTANCE_THRESHOLD=1.3

# --- Gmail OAuth2 ---
# Path to downloaded Google OAuth client secret JSON
GMAIL_CREDENTIALS_PATH=credentials/gmail_oauth.json
# Path where OAuth refresh token will be stored
GMAIL_TOKEN_PATH=credentials/gmail_token.json
# Authorized email address to send messages from
GMAIL_SENDER_EMAIL=user@example.com

# --- Human-in-the-Loop ---
# Seconds before an unapproved tool action times out
HITL_TIMEOUT_SECONDS=120

# --- Logging ---
# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
